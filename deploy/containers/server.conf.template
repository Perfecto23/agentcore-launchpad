resolver ${DNS_RESOLVER} valid=10s ipv6=off;
upstream launchpad_backend {
    zone launchpad_backend 64k;
    server ${BACKEND_UPSTREAM} resolve;
}
server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 260m;
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location ~ ^/(api|v1|share)(/|$) {
        proxy_pass http://launchpad_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Resolve the client only through the configured edge, then replace its chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CloudFront-Viewer-Address "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 1100s;
        proxy_send_timeout 1100s;
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
